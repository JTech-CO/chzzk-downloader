{
  "manifest_version": 3,
  "name": "Chzzk Downloader",
  "version": "2.3.3",
  "description": "치지직(Chzzk) 스트리머·편집자를 위한 클립/VOD 로컬 백업 도구",
  "permissions": [
    "downloads",
    "declarativeNetRequest",
    "offscreen"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://*.naver.com/*",
    "https://*.pstatic.net/*",
    "https://light-slit.akamaized.net/*",
    "https://ex-nlive-slitvod-streaming.navercdn.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "dash-parser.js",
        "media-resolver.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
